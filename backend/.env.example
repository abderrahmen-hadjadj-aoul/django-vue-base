# Copy this file to .env and set every value for your environment.
#   cp .env.example .env
# The .env file is git-ignored and must never contain real production secrets in
# the repo.
#
# EVERY variable below is REQUIRED — there are no defaults in settings.py. On
# startup the app validates that all of them are defined, prints a report, and
# refuses to start (listing what's missing) if any are absent. See config/env.py.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me

DEBUG=True

# Comma-separated list.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of origins trusted for unsafe (CSRF-protected) requests.
# Must include the frontend origin(s) for session-cookie auth to work.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL of the frontend, used to build links in emails (e.g. password reset).
FRONTEND_URL=http://localhost:5173

# Mark session/CSRF cookies Secure (HTTPS-only). Keep False for local http dev,
# set both to True in production behind HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email — the password-reset flow sends mail. The console backend prints emails
# to the terminal; configure a real SMTP backend in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@localhost

# Database URL. Local SQLite shown; Postgres example:
#   postgres://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Enables the /api/test/ support endpoints used by the Playwright e2e suite
# (reset DB, seed users/items, log in). The e2e run sets this itself against a
# dedicated throwaway DB — NEVER enable it in a real deployment; the endpoints
# are unauthenticated and destructive. See backend/api/e2e_views.py.
E2E_MODE=False

# Audit logging (see the backend `audit` app). Views call
# audit.services.record_request to log requests to the AuditLog table; each
# caller builds the audit body itself, logging only the safe fields.
AUDIT_LOG_ENABLED=True
# Bodies larger than this many bytes are noted but not stored.
AUDIT_MAX_BODY_BYTES=8192
