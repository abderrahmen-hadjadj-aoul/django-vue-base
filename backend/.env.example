# Copy this file to .env and adjust the values for your environment.
# The .env file is git-ignored and must never contain real production secrets in the repo.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me

DEBUG=True

# Comma-separated list.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL. Defaults to local SQLite when unset.
# Postgres example: postgres://user:password@localhost:5432/dbname
# DATABASE_URL=sqlite:///db.sqlite3
